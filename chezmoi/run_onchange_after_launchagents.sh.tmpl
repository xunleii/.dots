#!/usr/bin/env bash
{{ template "banner.tmpl" "LaunchAgents - reload changed plists" }}
# Re-runs whenever ANY file under chezmoi/Library/LaunchAgents/ changes (content
# or the set of files). Add a new plist there and it gets picked up for free.
{{ range (glob (joinPath .chezmoi.sourceDir "Library/LaunchAgents/*")) -}}
# hashlock {{ base . }}: {{ include . | sha256sum }}
{{ end -}}
{{ if eq .chezmoi.os "darwin" -}}
# No `set -e` and no non-zero exit: a launchctl hiccup here used to make chezmoi
# re-run this script (and bounce the proxy) on *every* apply.
set -uo pipefail

dom="gui/$(id -u)"
mkdir -p "$HOME/.local/state/headroom"

# Already loaded → kickstart -k (~1s blip). Not loaded yet → bootstrap. Never
# bootout: that opened a ~30s window with the proxy down, and any shell started
# in it skips ANTHROPIC_BASE_URL for its whole life (40-environment.fish checks
# /livez once, never again).
reload() {
    local plist="$1" label
    label="$(basename "$plist" .plist)"
    if launchctl print "$dom/$label" >/dev/null 2>&1; then
        echo "==> [chezmoi] launchd: kickstart -k $label"
        launchctl kickstart -k "$dom/$label" || true
    else
        echo "==> [chezmoi] launchd: bootstrap $label"
        launchctl bootstrap "$dom" "$plist" || true
    fi
}

for name in {{ range (glob (joinPath .chezmoi.sourceDir "Library/LaunchAgents/*")) }}{{ base . | trimSuffix ".tmpl" | quote }} {{ end }}""; do
    [ -n "$name" ] || continue
    plist="$HOME/Library/LaunchAgents/$name"
    [ -f "$plist" ] || continue
    reload "$plist"
done

# Don't let `chezmoi apply` return until the proxy answers again — otherwise the
# next shell races a still-booting proxy and skips the base URL.
# ponytail: hard-coded :8787, must match com.headroom.proxy.plist. Bump together.
for _ in $(seq 1 50); do
    curl -sf --max-time 0.4 http://127.0.0.1:8787/livez >/dev/null 2>&1 && break
    sleep 0.2
done
{{ end -}}
