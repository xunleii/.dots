sourceDir: {{ .chezmoi.sourceDir }}
format: yaml

# --- Chezmoi settings ---
git:
  autoAdd: true
  autoCommit: true
  autoPush: false
  commitMessageTemplate: |
    ~[chezmoi]: Auto-apply dotfiles changes

    {{ "{{" }}- with .chezmoi.status }}

    {{ "{{" }} range .Ordinary -}}
    {{ "{{" }} if and (eq .X 'A') (eq .Y '.') -}}- Add {{ "{{" }} .Path | targetRelPath }}
    {{ "{{" }} else if and (eq .X 'D') (eq .Y '.') -}}- Remove {{ "{{" }} .Path | targetRelPath }}
    {{ "{{" }} else if and (eq .X 'M') (eq .Y '.') -}}- Update {{ "{{" }} .Path | targetRelPath }}
    {{ "{{" }} else -}}{{ "{{" }} with (printf "unsupported XY: %q" (printf "%c%c" .X .Y)) }}{{ "{{" }} fail . }}{{ "{{" }} end }}
    {{ "{{" }}- end }}
    {{ "{{" }}- end -}}

    {{ "{{" }} range .RenamedOrCopied -}}
    {{ "{{" }} if and (eq .X 'R') (eq .Y '.') -}}- Change attributes of {{ "{{" }} .Path | targetRelPath }}
    {{ "{{" }} else -}}{{ "{{" }} with (printf "unsupported XY: %q" (printf "%c%c" .X .Y)) }}{{ "{{" }} fail . }}{{ "{{" }} end }}
    {{ "{{" }}- end }}
    {{ "{{" }}- end -}}

    {{ "{{" }} range .Unmerged -}}
    {{ "{{" }} fail "unmerged files" }}
    {{ "{{" }}- end -}}

    {{ "{{" }} range .Untracked -}}
    {{ "{{" }} fail "untracked files" }}
    {{ "{{" }}- end -}}

    {{ "{{" }}- end }}

diff:
  {{ if lookPath "difft" -}}
  command: difft
  {{- else -}}
  format: git
  {{- end }}

{{ if lookPath "fish" -}}
cd:
  command: fish
{{- end }}

# --- Template data ---
data:
  # Work machine? Gates machine-specific entries in dot_Brewfile.tmpl.
  work: {{ promptBoolOnce . "work" "Is this a work machine" }}
  name: {{ promptStringOnce . "name" "What is your GIT name" }}
  email: {{ promptStringOnce . "email" "What is your GIT email" }}
  {{/* Secure-Enclave keys (Secretive) can't be exported/scripted into existence —
       this only pre-fills the prompt from whatever's already loaded in the active
       ssh-agent (empty on a brand new machine, before Secretive/its key exist),
       so re-running `chezmoi init` after creating the key needs just Enter,
       not a copy-pasted pubkey. */}}
  {{ $sigDefault := output "sh" "-c" "ssh-add -L 2>/dev/null | head -1 || true" | trim -}}
  signingkey: {{ promptStringOnce . "signingkey" "What is your Git signing key (SSH or GPG)" $sigDefault }}
  bitwarden:
    # nested path must be a list, not "a.b" — a dotted string is treated as a
    # single flat key and re-prompts on every `chezmoi init`.
    access_token: {{ promptStringOnce . (list "bitwarden" "access_token") (printf "Get a Bitwarden access token for this machine (%s)" .chezmoi.fqdnHostname) }}
  runtime_dir: {{ promptStringOnce . "runtime_dir" "Where all the langauge runtimes/cache/packages should be installed" }}
