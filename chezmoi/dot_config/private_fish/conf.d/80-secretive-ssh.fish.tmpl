{{ template "banner.tmpl" "Fish - Secretive SSH Agent" }}

{{- if eq .chezmoi.os "darwin" }}
# Secretive (Secure Enclave-backed SSH agent) is the default ssh-agent: it
# handles commit signing and any host you connect to directly. Bitwarden
# stays locked at boot and is only pulled in for specific "machines" (fleet
# hosts stored in the vault) via the bwssh/bwansible*/bwansible-playbook
# wrappers in functions/, which override $SSH_AUTH_SOCK for one command only.
# Reference: https://github.com/maxgoedjen/secretive

set -l secretive_socket {{ .chezmoi.homeDir }}/Library/Containers/com.maxgoedjen.Secretive.SecretAgent/Data/socket.ssh

if test -S "$secretive_socket"
    set -gx SSH_AUTH_SOCK "$secretive_socket"
end
{{- end }}
