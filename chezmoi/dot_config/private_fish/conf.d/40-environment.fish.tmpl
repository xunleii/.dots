{{ template "banner.tmpl" "Fish - Environment Variables" }}

# --- Editor Configuration
# -----------------------------------------------------------------------------
set --global --export EDITOR "zed --wait"
set --global --export VISUAL $EDITOR
set --global --export GIT_EDITOR $EDITOR

# --- Machine layout (see docs/SPACES.md)
# -----------------------------------------------------------------------------
# Both roots are separate volumes. Names come from .chezmoidata.yaml, so fish
# and the docs can't drift apart — add a Space there, not here.
set --global --export RUNTIMES_ROOT {{ .runtimes_root | quote }}
set --global --export SPACES_ROOT {{ .spaces_root | quote }}
# Deliberately not exported: fish flattens a list into one colon-joined string
# on export, and nothing outside fish reads it.
set --global SPACES {{ range .spaces }}{{ . | quote }} {{ end }}

# --- Tool-specific Variables
# -----------------------------------------------------------------------------
set --global --export TF_PLUGIN_CACHE_DIR "$HOME/.terraform.d/plugin-cache"

# gpg needs to know which tty to prompt on (pinentry-mac). Interactive only:
# `tty` fails outside a terminal and would set the variable to "not a tty".
status is-interactive; and set --global --export GPG_TTY (tty)

# --- Headroom proxy (transparent context compression, per-project attribution)
# Route Claude Code / Codex through the local proxy only when it is actually up,
# otherwise a dead ANTHROPIC_BASE_URL breaks every LLM call. Liveness is checked
# once per shell (network call); the /p/<project> suffix is recomputed on every
# `cd` (local git calls only, cheap) so headroom's per-project dashboard fills in.
# ponytail: doesn't recheck liveness on cd — a proxy dying mid-session keeps
# pointing at it until the next shell. Upgrade if that bites.
# Caches the computed base URL per git toplevel so cd-ing within the same repo
# (the common case) costs 1 git spawn instead of 3 — was showing up as a
# multi-second stall on every `cd` in large/slow-disk repos.
if type -q curl; and curl -sf --max-time 0.4 http://127.0.0.1:8787/livez >/dev/null 2>&1
    function __headroom_project_url
        set -l base http://127.0.0.1:8787
        set -l toplevel (git rev-parse --show-toplevel 2>/dev/null)
        if test -n "$toplevel"
            if test "$toplevel" = "$__headroom_last_toplevel"
                set base $__headroom_last_base
            else
                # host/user/repo -> host-user-repo (shared normalizer, see
                # functions/__git_remote_slug.fish). Empty when there's no
                # remote: the repo then just reports under the bare base URL.
                set -l project (__git_remote_slug | string replace -a / -)
                test -n "$project"; and set base "$base/p/$project"
                set -g __headroom_last_toplevel $toplevel
                set -g __headroom_last_base $base
            end
        else
            set -g __headroom_last_toplevel ''
        end
        set --global --export ANTHROPIC_BASE_URL $base
    end
    __headroom_project_url
    function __headroom_on_cd --on-variable PWD
        __headroom_project_url
    end
end

# --- GitHub CLI
# -----------------------------------------------------------------------------
# ponytail: timeout guards against a stuck macOS Keychain prompt silently
# stalling every new shell — was the other source of a slow first prompt.
if type -q gh; and type -q timeout
    set -l token (timeout 1 gh auth token 2>/dev/null)
    if test -n "$token"
        set --global --export GITHUB_TOKEN "$token"
    end
end

# --- Locale
# -----------------------------------------------------------------------------
set --erase LC_ALL
set --global --export LANG en_US.UTF-8
set --global --export LC_CTYPE en_US.UTF-8
set --global --export LC_COLLATE en_US.UTF-8
set --global --export LC_MESSAGES en_US.UTF-8
