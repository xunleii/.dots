{{ template "banner.tmpl" "Mise - Configuration file" }}
[settings]
experimental = true
idiomatic_version_file_enable_tools = ["terraform"]

[tools]
# --- Languages ---
go = "1.27"
node = "26"
rust = "1.98"
python = "3.14"

# --- Tools ---
# CLI tools live in the Brewfile now (bat, fd, eza, fzf, uv); mise keeps
# language runtimes + tools brew doesn't carry well.
jqp = "latest"
crane = "latest"
doggo = "latest"
"npm:czg" = "latest"
"pipx:claude-swap" = "latest"
"github:str4d/rage" = "latest"

# Claude Code status line + hook renderer (see dot_claude/private_settings.json).
# Not on Homebrew; mise installs it once and puts `ccstatusline` on PATH, so no
# hook or status-line refresh has to resolve a package at call time.
"npm:ccstatusline" = "latest"

# Plan/diff annotation UI (the plannotator-* skills drive it). Upstream only
# ships a `curl | bash` installer and bare GitHub release binaries, so it goes
# through ubi, which picks the darwin/arm64 asset from the release. Keeping it
# here rather than as a chezmoi external puts the ~120 MB binary on
# {{ .runtimes_root }} instead of the system volume.
# NOTE: it can self-update in place; `mise install` is what decides the version
# from now on, so re-run it after an in-place update to get back in sync.
"ubi:backnotprop/plannotator" = "latest"

# Headroom lives outside mise now — installed via `uv tool` in
# run_onchange_after_mise.sh.tmpl. It runs headless as a LaunchAgent and
# launchd has no TCC access to the external {{ .runtimes_root }} volume where
# mise puts its venvs, so the venv must sit on the internal disk.

[env]
MISE_DATA_DIR = "{{ .runtimes_root }}/mise"

# Redirects each toolchain's cache/install dir onto the external runtimes
# volume. Only the languages declared in [tools] above belong here.

# Node
npm_config_cache = "{{ .runtimes_root }}/node/npm/cache"
npm_config_prefix = "{{ .runtimes_root }}/node/npm"

# Go
GOPATH = "{{ .runtimes_root }}/go"
GOCACHE = "{{ .runtimes_root }}/go/cache"
GOMODCACHE = "{{ .runtimes_root }}/go/mod"

# Rust
CARGO_HOME = "{{ .runtimes_root }}/rust/cargo"
CARGO_TARGET_DIR = "{{ .runtimes_root }}/rust/cargo/target"

# Python
PIP_CACHE_DIR = "{{ .runtimes_root }}/python/pip"
UV_CACHE_DIR = "{{ .runtimes_root }}/python/uv"

# PATH definition using mise's env._.path
# This handles prepending to PATH automatically
_.path = [
    "{{ .runtimes_root }}/node/npm/bin",
    "{{ .runtimes_root }}/go/bin",
    "{{ .runtimes_root }}/rust/cargo/bin",
    "{{ .chezmoi.homeDir }}/.local/bin"
]
