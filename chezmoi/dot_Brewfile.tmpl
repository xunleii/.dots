{{- $work := get . "work" -}}
# vim: set ft=ruby :
# Templated Brewfile — rendered to ~/.Brewfile by chezmoi.
# `run_onchange_after_brew.sh.tmpl` runs `brew bundle --global` then
# `brew bundle cleanup --global --force`, so anything NOT listed here is
# uninstalled on the next `chezmoi apply`. Machine-specific entries below are
# gated on `.work` (prompted once by `chezmoi init`); this render targets
# {{ if $work }}a WORK machine{{ else }}a PERSONAL machine{{ end }}.
#
# Trailing markers consumed by run_onchange_after_brew.sh.tmpl:
#   # @trust  -> `brew trust --tap <user/repo>` before `brew bundle`
#   # @link   -> `brew link --overwrite <formula>` after `brew bundle`

# --- Fonts
cask "font-iosevka-term-nerd-font"  # Iosevka Term patched with Nerd Font icons

# --- Shells & prompt
brew "bash"      # system bash is 3.2, unusable
brew "fish"      # interactive shell
brew "starship"  # cross-shell prompt

# --- GNU userland (prefer GNU over BSD; gnubin dirs added to PATH in fish 00-base)
brew "coreutils"  # GNU file/shell/text utils
brew "findutils"  # GNU find, xargs, locate
brew "gawk"       # GNU awk
brew "gnu-sed"    # GNU sed
brew "grep"       # GNU grep/egrep/fgrep

# --- Dotfiles / secrets
brew "chezmoi"        # dotfiles manager
brew "bitwarden-cli"  # password manager CLI
brew "gnupg"          # OpenPGP implementation
brew "pinentry-mac"   # macOS-native GPG passphrase prompt

# --- Development Tools
brew "cmake"       # cross-platform build system generator
brew "colordiff"   # colorized diff output
brew "difftastic"  # syntax-aware structural diff
brew "fzf"         # fuzzy finder
brew "gh"          # GitHub CLI
brew "git-absorb"  # auto-fixup commits into git history
brew "git-lfs"     # git large file storage
brew "lazygit"     # terminal UI for git
brew "neovim"      # Vim-fork text editor
brew "uv"          # Python package/project manager
brew "wget"        # HTTP(S)/FTP file retriever
cask "ghostty"     # GPU-accelerated, platform-native terminal
cask "zed"         # multiplayer code editor

# --- AI / coding agents
brew "llmfit"                 # check what LLMs fit your hardware
brew "nono"                   # sandboxes `claude` (see 50-aliases.fish) — kernel-level tool isolation
brew "rtk"                    # CLI proxy, trims noisy command output before it hits context
cask "claude"                 # Anthropic's Claude desktop app
cask "claude-code"            # terminal-based AI coding assistant
cask "steipete/tap/codexbar"  # menu bar usage/status CLI for Codex @trust
cask "lm-studio"              # run local LLMs

# --- System Utilities
brew "atuin"     # shell history sync/search
brew "btop"      # resource monitor (TUI)
brew "procs"     # modern `ps` replacement
brew "tree"      # directory tree listing
brew "zoxide"    # frecency-based `cd` replacement
cask "orbstack"  # lightweight Docker Desktop replacement
cask "raycast"   # launcher / productivity toolbox

# --- File Management
brew "bat"         # `cat` with syntax highlighting
brew "eza"         # modern `ls` replacement
brew "fd"          # fast `find` alternative
brew "ripgrep"     # fast recursive grep
cask "appcleaner"  # thorough application uninstaller
cask "rar"         # RAR archive tool
cask "rsyncui"     # GUI for rsync

# --- Text / binary utilities
brew "hexyl"   # hex viewer
brew "flock"   # lock a file for the duration of a command
brew "sponge"  # soak up stdin, write to a file (moreutils)

# --- Graphics
brew "graphviz"  # graph/diagram rendering (`dot`)

# --- Network
brew "ipcalc"                      # IP subnet calculator
brew "hanshuaikang/nbping/nbping"  # Rust ping tool with real-time visualizations @trust

# --- Security
cask "bitwarden"        # password/login vault (fleet/"machines" SSH access, see bwssh)
cask "little-snitch"    # outbound application firewall
cask "secretive"        # Secure Enclave-backed SSH agent (default: commit signing + direct SSH)
cask "toolhive-studio"  # install/manage/run MCP servers

# --- Communication
cask "slack"  # team chat

# --- Internet & network
cask "google-chrome"  # web browser
cask "orion"          # WebKit-based privacy browser
cask "tailscale-app"  # WireGuard-based mesh VPN
cask "zen"            # Gecko-based browser

# --- Notes
cask "octarine"  # markdown note-taking app

# --- Media
cask "deezer"  # music streaming
cask "vlc"     # media player

# --- Misc
cask "hermes-desktop"  # open-source desktop AI agent

{{ if not $work -}}
# --- Personal machine only
cask "steam"  # game distribution platform
{{- end }}

{{ if $work -}}
# --- Work machine only
cask "gcloud-cli"       # Google Cloud SDK
cask "microsoft-teams"  # chat/video meetings
cask "wifiman"          # wifi network diagnostics
{{- end }}

{{ if eq .chezmoi.hostname "Mac-Mini-M4" -}}
# --- Mac-Mini-M4 only
cask "autodesk-fusion"   # CAD/CAM/CAE + PCB software
cask "bambu-studio"      # 3D-printer slicer
cask "betterdisplay"     # external display management
cask "istat-menus"       # system monitor menu bar
cask "tinymediamanager"  # media library organizer
{{- end }}
