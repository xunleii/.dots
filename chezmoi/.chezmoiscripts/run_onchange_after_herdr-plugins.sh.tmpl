#!/bin/bash
# Re-runs the `configure` action of herdr plugins whose setup writes into Herdr's config.toml
# (managed blocks / keybindings) and into agent hook files. Each one is idempotent, so a re-run
# with nothing to change is a no-op. Re-runs when this script changes.
# herdr-radar: https://github.com/hhdebb/herdr-radar  herdr-projects: https://github.com/eliasstravik/herdr-projects
set -euo pipefail
command -v herdr >/dev/null || exit 0

# Plugin actions run asynchronously: invoke returns before the work is done, so wait for the
# latest log record of that plugin to leave "running" and report its real status.
configure_plugin() {
    local plugin="$1" status="" _
    herdr plugin action invoke configure --plugin "$plugin" >/dev/null || {
        echo "herdr: $plugin configure could not start, run it by hand" >&2
        return 0
    }
    for _ in $(seq 1 30); do
        status=$(herdr plugin log list --plugin "$plugin" --limit 1 2>/dev/null | grep -o '"status":"[a-z]*"' | head -n1 | cut -d'"' -f4)
        [ "$status" = "running" ] || break
        sleep 1
    done
    [ "$status" = "succeeded" ] || echo "herdr: $plugin configure ended with status '${status:-unknown}', see: herdr plugin log list --plugin $plugin" >&2
}

configure_plugin hhdebb.herdr-radar
configure_plugin herdr-projects
