#!/bin/bash
# Registers the memex MCP server in Claude Code's user config (~/.claude.json, which
# chezmoi does not manage — MCP servers do not belong in settings.json). The skill
# itself is vendored at dot_claude/skills/memex-search.
# Re-runs when this script changes or when memex is upgraded.
# memex version: {{ output "sh" "-c" "memex --version 2>/dev/null || true" | trim }}
set -euo pipefail
command -v memex >/dev/null || exit 0
command -v claude >/dev/null || exit 0
if ! claude mcp get memex >/dev/null 2>&1; then
    claude mcp add --scope user memex -- memex mcp --transport stdio
fi
