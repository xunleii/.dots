#!/usr/bin/env bash
{{ template "banner.tmpl" "Mise - Post-install/Post-upgrade script" }}
# hashlock: {{ include "dot_config/private_mise/config.toml.tmpl" | sha256sum }}
# hashlock: {{ includeTemplate "Library/LaunchAgents/com.headroom.proxy.plist.tmpl" . | sha256sum }}

export PATH="$HOME/.local/bin:$PATH"

echo "==> [chezmoi] mise: config changed — installing tools + refreshing completions…"

source <(mise activate bash)

mkdir -p ~/.config/fish/conf.d ~/.config/fish/completions
mise completion fish > ~/.config/fish/completions/mise.fish

mise install --yes
# Best-effort: prune walks every trusted mise config, so a broken project
# config elsewhere on disk must not fail `chezmoi apply`.
mise prune || true
echo "==> [chezmoi] mise: done."

# --- Headroom proxy LaunchAgent (macOS) — headroom is a mise tool, so (re)load
#     its service here, after `mise install` has provisioned it.
{{- if eq .chezmoi.os "darwin" }}
plist="$HOME/Library/LaunchAgents/com.headroom.proxy.plist"
if [ -f "$plist" ]; then
    echo "==> [chezmoi] headroom: reloading proxy LaunchAgent…"
    mkdir -p "$HOME/.local/state/headroom"
    svc="gui/$(id -u)/com.headroom.proxy"

    if launchctl print "$svc" >/dev/null 2>&1; then
        launchctl bootout "$svc" 2>/dev/null || true
        # bootout is async — bootstrapping before teardown finishes silently
        # leaves the agent unloaded. Wait it out.
        for _ in $(seq 1 25); do
            launchctl print "$svc" >/dev/null 2>&1 || break
            sleep 0.2
        done
    fi
    # RunAtLoad in the plist starts it; no kickstart needed.
    launchctl bootstrap "gui/$(id -u)" "$plist" 2>/dev/null || true
fi
{{- end }}
