#!/usr/bin/env bash
{{ template "banner.tmpl" "Mise - Post-install/Post-upgrade script" }}
# hashlock: {{ include "dot_config/private_mise/config.toml.tmpl" | sha256sum }}

export PATH="$HOME/.local/bin:$PATH"

echo "==> [chezmoi] mise: config changed — installing tools + refreshing completions…"

source <(mise activate bash)

mkdir -p ~/.config/fish/conf.d ~/.config/fish/completions
mise completion fish > ~/.config/fish/completions/mise.fish

mise install --yes
# Best-effort: prune walks every trusted mise config, so a broken project
# config elsewhere on disk must not fail `chezmoi apply`.
mise prune || true
echo "==> [chezmoi] mise: done."

# --- Headroom — context-compression proxy for Claude Code. Installed via
#     `uv tool` (not mise): it runs headless as the com.headroom.proxy
#     LaunchAgent, and launchd has no TCC grant for the external
#     {{ .runtime_dir }} volume where mise puts its venvs — Python can't even
#     read its own pyvenv.cfg there and the agent throttle-loops. `uv tool`
#     installs to ~/.local (internal disk) with a standalone py3.13, and drops
#     the `headroom` shim on PATH.
echo "==> [chezmoi] headroom: installing/updating via uv tool…"
uv tool install --python 3.13 \
    'headroom-ai[proxy,mcp,code,ml,memory,relevance,reports]'
uv tool upgrade headroom-ai || true
# run_onchange_after_launchagents.sh sorts BEFORE this script, so it already
# reloaded the proxy onto the *old* venv. Kick it once more onto the venv we
# just upgraded. (The launchagents script also handles plist-only changes.)
launchctl kickstart -k "gui/$(id -u)/com.headroom.proxy" 2>/dev/null || true
