<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Outside the nono sandbox: receives a URL on a unix socket (launchd socket
         activation, one process per connection) and has Ghostty open it in a split. -->
    <key>Label</key>
    <string>dev.axnic.clawd-browser</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/sh</string>
        <string>{{ .chezmoi.homeDir }}/.local/bin/clawd-browser-listener</string>
    </array>
    <key>inetdCompatibility</key>
    <dict>
        <key>Wait</key>
        <false/>
    </dict>
    <key>Sockets</key>
    <dict>
        <key>Listeners</key>
        <dict>
            <key>SockFamily</key>
            <string>Unix</string>
            <key>SockPathName</key>
            <string>{{ .chezmoi.homeDir }}/.local/state/clawd-browser.sock</string>
            <key>SockPathMode</key>
            <integer>384</integer>
        </dict>
    </dict>
</dict>
</plist>
