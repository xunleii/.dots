<?xml version="1.0" encoding="UTF-8"?>
<!-- Managed by chezmoi. Reloaded by run_onchange_after_mise.sh.tmpl.
     The `uv tool` shim (~/.local/bin/headroom) lives on the INTERNAL disk — it
     must not sit on the external {{ .runtime_dir }} volume, where a launchd
     agent has no TCC access and Python can't read its own pyvenv.cfg (EPERM).
     arg0 is /bin/sh, not the shim directly: launchd's xpcproxy wedges when it
     has to exec an ad-hoc-signed venv interpreter itself (job stuck in state
     "xpcproxy", never binds). A signed system binary execs cleanly, then its
     own exec of the shim runs under the normal (permissive) exec path. -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.headroom.proxy</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/sh</string>
        <string>-c</string>
        <string>exec "{{ .chezmoi.homeDir }}/.local/bin/headroom" proxy --port 8787 --no-telemetry</string>
    </array>

    <key>EnvironmentVariables</key>
    <dict>
        <key>HOME</key>
        <string>{{ .chezmoi.homeDir }}</string>
        <key>HEADROOM_TELEMETRY</key>
        <string>off</string>
        <!-- launchd redirects stdout to a file, so Python block-buffers it and
             the log stays empty while the process is alive. Force line-buffered
             so proxy.log actually shows startup progress / where it stalls. -->
        <key>PYTHONUNBUFFERED</key>
        <string>1</string>
    </dict>

    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>ThrottleInterval</key>
    <integer>15</integer>
    <key>ProcessType</key>
    <string>Background</string>

    <key>StandardOutPath</key>
    <string>{{ .chezmoi.homeDir }}/.local/state/headroom/proxy.log</string>
    <key>StandardErrorPath</key>
    <string>{{ .chezmoi.homeDir }}/.local/state/headroom/proxy.log</string>
</dict>
</plist>
