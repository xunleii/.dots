{{- /* Default title used by every single-argument call
       (`{{ template "banner.tmpl" "Fish - Base Configuration" }}`), where the
       argument is the subtitle. Pass a map with .Title/.Subtitle to override. */ -}}
{{- $title := ".dots" -}}
{{- if kindIs "map" . -}}{{- $title = .Title -}}{{- end -}}
{{- $title = (trim (regexReplaceAll "(.)" $title "${1} ")) -}}

{{- $subtitle := . -}}
{{- if kindIs "map" . -}}{{- $subtitle = .Subtitle -}}{{- end -}}
