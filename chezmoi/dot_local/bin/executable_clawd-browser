#!/bin/sh
# Usage: clawd-browser [-d right|left|up|down] URL   (default direction: right)
# Runs inside the nono sandbox (clawd sets PLANNOTATOR_BROWSER to this): the sandbox
# cannot send Apple Events, so ask the launchd listener (clawd-browser-listener) to
# split THIS Ghostty pane. Protocol v1, one line, tab-separated:
#   v1 <surface id> <direction> <url>   ->   ok | err <reason>
dir=right
[ "$1" = -d ] && { dir=$2; shift 2; }
reply=$(printf 'v1\t%s\t%s\t%s\n' "${GHOSTTY_SURFACE_ID:-none}" "$dir" "$1" |
  nc -U "$HOME/.local/state/clawd-browser.sock") || { echo "clawd-browser: listener unreachable" >&2; exit 1; }
[ "$reply" = ok ] || { echo "clawd-browser: $reply" >&2; exit 1; }
