{{- $work := get . "work" -}}
{{- /* Plugins always on, plus work-only ones added below. */ -}}
{{- $enabledPlugins := dict
      "ponytail@ponytail" true
      "nono@nolabs-ai" true
      "superpowers@claude-plugins-official" true
      "code-review@claude-plugins-official" true
      "skill-creator@claude-plugins-official" true
      "claude-md-management@claude-plugins-official" true
-}}
{{- if $work -}}
{{- $_ := set $enabledPlugins "atlassian@claude-plugins-official" true -}}
{{- end -}}
{{- /*
Key order below matches what Claude Code itself writes back on every touch
(model change, plugin toggle, ccstatusline's own `--hook` installer, …), not
just taste — chezmoi apply is a no-op against that rewrite only if the order
matches, otherwise `chezmoi diff` shows the same reshuffle every time. Same
reason the two ccstatusline-managed hook entries below carry no extra marker
key: Claude's settings writer drops anything it doesn't know about, so a
`_tag` field here just churns forever instead of surviving.
*/ -}}
{
  "permissions": {
    "allow": [
      "Bash(nono why *)",
      "Bash(nono profile guide)",
      "Bash(nono profile validate *)",
      "Bash(nono profile show *)"
    ]
  },
  "model": "sonnet",
  "hooks": {
    "Stop": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/per-command/allow-sleep.sh"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/per-command/prevent-sleep.sh"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "ccstatusline --hook"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "rtk hook claude"
          }
        ]
      },
      {
        "matcher": "Skill",
        "hooks": [
          {
            "type": "command",
            "command": "ccstatusline --hook"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "ccstatusline",
    "padding": 0,
    "refreshInterval": 10
  },
  "enabledPlugins": {{ $enabledPlugins | toJson }},
  "extraKnownMarketplaces": {
    "anthropic-agent-skills": {
      "source": {
        "source": "github",
        "repo": "anthropics/skills"
      }
    },
    "ponytail": {
      "source": {
        "source": "github",
        "repo": "DietrichGebert/ponytail"
      }
    }
  },
  "tui": "fullscreen",
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true
}
