{{ $os_arch := printf "%s/%s" .chezmoi.os .chezmoi.arch -}}
# This file has been generated for {{ $os_arch }} system
# Only darwin/{amd64,arm64} assets exist in .chezmoidata.yaml — the `has`
# guards below stay as a safety net for a Mac arch that isn't listed yet.

# --- kubectl fish completions (kubectl ships none for fish)
# Fetched and cached at apply time, so nothing hits the network from the shell
# startup path. Pinned to a commit: bump the SHA to update.
[".config/fish/completions/kubectl.fish"]
type = "file"
url = "https://raw.githubusercontent.com/evanlucas/fish-kubectl-completions/ced676392575d618d8b80b3895cdc3159be3f628/completions/kubectl.fish"

{{ with .packages.mise -}}
{{ if has $os_arch (keys .release_names) -}}
# --- Mise installation
[".local/bin/mise"]
type = "file"
{{ if eq .version "latest" -}}
url = "{{ gitHubLatestReleaseAssetURL "jdx/mise" (get .release_names $os_arch) }}"
{{- else -}}
url = "{{ gitHubReleaseAssetURL "jdx/mise" .version (get .release_names $os_arch) }}"
{{- end }}
executable = true
{{- else -}}
# --- Mise not available for {{ $os_arch }}
{{- end }}
{{- end }}

{{ with .packages.usage -}}
{{ if has $os_arch (keys .release_names) -}}
# --- Usage installation
[".local/bin/usage"]
type = "archive-file"
{{ if eq .version "latest" -}}
url = "{{ gitHubLatestReleaseAssetURL "jdx/usage" (get .release_names $os_arch) }}"
{{- else -}}
url = "{{ gitHubReleaseAssetURL "jdx/usage" .version (get .release_names $os_arch) }}"
{{- end }}
path = "usage"
executable = true
{{- else -}}
# --- Usage not available for {{ $os_arch }}
{{- end }}
{{- end }}

{{/* ocx: installed from GitHub release assets (not via Homebrew) */}}
{{ with .packages.ocx -}}
{{ if has $os_arch (keys .release_names) -}}
# --- ocx installation
[".local/bin/ocx"]
type = "file"
{{ if eq .version "latest" -}}
url = "{{ gitHubLatestReleaseAssetURL "kdcokenny/ocx" (get .release_names $os_arch) }}"
{{- else -}}
url = "{{ gitHubReleaseAssetURL "kdcokenny/ocx" .version (get .release_names $os_arch) }}"
{{- end }}
executable = true
{{- else -}}
# --- ocx not available for {{ $os_arch }}
{{- end }}
{{- end }}
