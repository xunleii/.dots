# --- Unmanaged leftovers that every interactive shell still sourced
# 30-utilities: duplicates the atuin/zoxide init in 25-tools, and sources
#   brew-wrap, which fights the `brew` wrapper in 45-brew
# 80-bitwarden-ssh: points $SSH_AUTH_SOCK at Bitwarden, overriding the
#   Secretive default from 80-secretive-ssh. Bitwarden is opt-in per command,
#   via bwssh
# 80-fzf-tab-config: configures xxxbrian/fzf-tab.fish, which is not in
#   fish_plugins (fifc is, configured in 10-keybindings)
.config/fish/conf.d/30-utilities.fish
.config/fish/conf.d/80-bitwarden-ssh.fish
.config/fish/conf.d/80-fzf-tab-config.fish

# --- Stale copies in ~/.local/bin that shadowed the real install
# conf.d/00-base puts ~/.local/bin ahead of /opt/homebrew/bin, and mise's shims
# ahead of both, so these old copies were the ones actually being run — not the
# versions brew and mise manage.
# plannotator: was a `curl | bash` install; it is a mise tool now, so removing
# the binary and installing the shim happen in the same apply.
.local/bin/lazygit
.local/bin/zoxide
.local/bin/plannotator
