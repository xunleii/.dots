#
#                                   . d o t s
#                           Mise - dev toolchains
#
# -----------------------------------------------------------------------------

# Deployed to ~/.config/mise/conf.d/dev/mise.toml by the dev module: global tools and env.
[env]
# Redirects each toolchain's cache/install dir onto the external runtimes volume.
# Only the languages declared in [tools] below belong here.

# Node
npm_config_cache = "{{ vars.runtimes_root }}/node/npm/cache"
npm_config_prefix = "{{ vars.runtimes_root }}/node/npm"

# Go
GOPATH = "{{ vars.runtimes_root }}/go"
GOCACHE = "{{ vars.runtimes_root }}/go/cache"
GOMODCACHE = "{{ vars.runtimes_root }}/go/mod"

# Rust
CARGO_HOME = "{{ vars.runtimes_root }}/rust/cargo"
CARGO_TARGET_DIR = "{{ vars.runtimes_root }}/rust/cargo/target"

# Python
PIP_CACHE_DIR = "{{ vars.runtimes_root }}/python/pip"
UV_CACHE_DIR = "{{ vars.runtimes_root }}/python/uv"

_.path = [
    "{{ vars.runtimes_root }}/node/npm/bin",
    "{{ vars.runtimes_root }}/go/bin",
    "{{ vars.runtimes_root }}/rust/cargo/bin",
]

[tools]
# --- Languages
go = "1.27"
node = "26"
rust = "1.99"
python = "3.15"

# --- CLI tools brew doesn't carry well
jqp = "latest"
crane = "latest"
doggo = "latest"
"github:str4d/rage" = "latest"
