{
  "permissions": {
    "defaultMode": "auto",
    "allow": [
      "Bash(nono why *)",
      "Bash(nono profile guide)",
      "Bash(nono profile validate *)",
      "Bash(nono profile show *)"
    ]
  },
  "model": "sonnet",
  "env": {
    "CLAUDE_CODE_ENABLE_FUNCTION_HOOKS": "1"
  },
  "hooks": {
{%- if os() == "macos" %}
    "Stop": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/per-command/allow-sleep.sh"
          }
        ]
      }
    ],
{%- endif %}
    "UserPromptSubmit": [
{%- if os() == "macos" %}
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/per-command/prevent-sleep.sh"
          }
        ]
      },
{%- endif %}
      {
        "hooks": [
          {
            "type": "command",
            "command": "ccstatusline --hook"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "rtk hook claude"
          }
        ]
      },
      {
        "matcher": "Skill",
        "hooks": [
          {
            "type": "command",
            "command": "ccstatusline --hook"
          }
        ]
      },
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/per-command/gitleaks-redact.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/per-command/gitleaks-redact.sh"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "ccstatusline",
    "padding": 0,
    "refreshInterval": 10
  },
  "enabledPlugins": {
    "claude-md-management@claude-plugins-official": true,
    "claude-mermaid@claude-mods": true,
    "code-review@claude-plugins-official": true,
    "nono@nolabs-ai": true,
    "plannotator@plannotator": true,
    "ponytail@ponytail": true,
    "remember@claude-plugins-official": true,
    "skill-creator@claude-plugins-official": true,
    "superpowers@claude-plugins-official": true,
    "terminal-browser@terminal-browser": true,
    "understand-anything@understand-anything": true,
    "waza@waza": true
  },
  "extraKnownMarketplaces": {
    "anthropic-agent-skills": {
      "source": {
        "source": "github",
        "repo": "anthropics/skills"
      }
    },
    "ponytail": {
      "source": {
        "source": "github",
        "repo": "DietrichGebert/ponytail"
      }
    },
    "plannotator": {
      "source": {
        "source": "github",
        "repo": "backnotprop/plannotator"
      }
    },
    "waza": {
      "source": {
        "source": "github",
        "repo": "tw93/Waza"
      }
    },
    "understand-anything": {
      "source": {
        "source": "github",
        "repo": "Egonex-AI/Understand-Anything"
      }
    },
    "claude-mods": {
      "source": {
        "source": "github",
        "repo": "galElmalah/claude-mods"
      }
    },
    "terminal-browser": {
      "source": {
        "source": "github",
        "repo": "zenbu-labs/terminal-browser"
      }
    }
  },
  "pluginConfigs": {
    "terminal-browser@terminal-browser": {
      "options": {
        "agentTool": true
      }
    }
  },
  "tui": "fullscreen",
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true
}
