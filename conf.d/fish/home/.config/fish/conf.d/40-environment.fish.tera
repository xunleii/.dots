#                                       __
#                                     /\\ \
#                                   /\\ \\ \\
#                                   \// // //
#                                     \//_/
#
#                                   . d o t s
#                         Fish - Environment Variables
#
# -----------------------------------------------------------------------------


# --- Editor Configuration
# -----------------------------------------------------------------------------
set --global --export EDITOR "zed --wait"
set --global --export VISUAL $EDITOR
set --global --export GIT_EDITOR $EDITOR

# --- Machine layout (see docs/SPACES.md)
# -----------------------------------------------------------------------------
# Both roots are separate volumes. Names come from [vars] in mise.toml, so fish
# and the docs can't drift apart — add a Space there, not here.
set --global --export RUNTIMES_ROOT {{ vars.runtimes_root | json_encode }}
set --global --export SPACES_ROOT {{ vars.spaces_root | json_encode }}
# Deliberately not exported: fish flattens a list into one colon-joined string
# on export, and nothing outside fish reads it.
set --global SPACES {% for s in vars.spaces | split(pat=" ") %}{{ s | json_encode }} {% endfor %}

# --- Tool-specific Variables
# -----------------------------------------------------------------------------
set --global --export TF_PLUGIN_CACHE_DIR "$HOME/.terraform.d/plugin-cache"

# gpg needs to know which tty to prompt on (pinentry-mac). Interactive only:
# `tty` fails outside a terminal and would set the variable to "not a tty".
status is-interactive; and set --global --export GPG_TTY (tty)

# --- GitHub CLI
# -----------------------------------------------------------------------------
# ponytail: timeout guards against a stuck macOS Keychain prompt silently
# stalling every new shell — was the other source of a slow first prompt.
if type -q gh; and type -q timeout
    set -l token (timeout 1 gh auth token 2>/dev/null)
    if test -n "$token"
        set --global --export GITHUB_TOKEN "$token"
    end
end

# --- Locale
# -----------------------------------------------------------------------------
set --erase LC_ALL
set --global --export LANG en_US.UTF-8
set --global --export LC_CTYPE en_US.UTF-8
set --global --export LC_COLLATE en_US.UTF-8
set --global --export LC_MESSAGES en_US.UTF-8
